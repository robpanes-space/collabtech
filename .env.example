# ─────────────────────────────────────────────────────────────────────────────
# Jira Custom Dashboard — environment template.
# Copy to .env.local (local) or set in your host's secret store (production).
# All values are SERVER-SIDE ONLY. Never prefix them with NEXT_PUBLIC_.
# Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Jira Cloud connection (required)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SCRUM
JIRA_BOARD_ID=1

# Optional Jira field/behavior overrides (blank = auto-discover / defaults)
JIRA_STORY_POINTS_FIELD=
JIRA_RISK_FIELD=
JIRA_EPIC_LINK_FIELD=

# Optional, server-side only: comma-separated Jira status names that mean "blocked", in addition
# to "is blocked by" issue links. Exact names, case-insensitive. Done-category work is never
# counted as blocked. Leave empty to use issue links only.
JIRA_BLOCKED_STATUSES=Blocked

# Display time zone for all dashboard timestamps (IANA name; required in production)
DASHBOARD_TIME_ZONE=Asia/Manila

# Jira deep links ("SCRUM-14 ↗"). Set to false if clients have no Jira access.
DASHBOARD_JIRA_LINKS=true

# ── Authentication (required in production) ─────────────────────────────────
# Two sign-in methods produce the same dashboard session; the email is the identity.
#  1. "Sign in with Atlassian" (OAuth 2.0, identity only — scope read:me). Optional.
#  2. Email + password (fallback / admin). Users in DASHBOARD_USERS.
# Neither grants access by itself: the email must be on the allowlist
# (DASHBOARD_ALLOWED_EMAILS + every DASHBOARD_USERS email). Dashboard data ALWAYS comes from
# the Jira service account above — never from a signed-in user's Atlassian token.

# Atlassian OAuth 2.0 (3LO) app from https://developer.atlassian.com/console/myapps/
# All three or none. The callback must EXACTLY match the URL registered in the app.
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_CALLBACK_URL=https://dashboard.example.com/api/auth/atlassian/callback

# Emails allowed to sign in with Atlassian (comma/newline separated, case-insensitive).
DASHBOARD_ALLOWED_EMAILS=
# true = anyone with access (Browse Projects) to the Jira project may sign in with Atlassian —
# invite people to the project in Jira and they can sign in; remove them and access ends within
# ~5 minutes. Checked by Atlassian account ID using the Jira service account. If the project is
# open to all site users, everyone with Jira on the site qualifies (see /admin/readiness).
DASHBOARD_JIRA_PROJECT_ACCESS=true

# Allowed users: comma- or newline-separated "email:password-hash" entries.
# Generate each hash with:  npm run auth:hash-password
# Example: DASHBOARD_USERS=client@example.com:scrypt.16384.8.1.<salt>.<hash>
DASHBOARD_USERS=
# ≥ 32 random characters. Generate with:  npm run auth:session-secret
# Rotating it signs everyone out.
DASHBOARD_SESSION_SECRET=
# Session lifetime in hours (default 168 = 7 days, max 720)
DASHBOARD_SESSION_HOURS=168
# Optional: comma-separated emails allowed to open /admin/readiness (data-quality diagnostics).
# Unset = every signed-in user may. Recommended: list only your internal team.
DASHBOARD_ADMIN_EMAILS=
# Local development only: skip sign-in (ignored when NODE_ENV=production)
DASHBOARD_AUTH_DISABLED=false

# Optional build label override (defaults to package.json version + commit SHA when available)
APP_VERSION=
